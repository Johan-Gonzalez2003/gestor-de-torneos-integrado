# Copie este archivo a .env (NO se sube a Git) y cambie los valores.

# --- Seguridad (JWT + usuarios de demostración) ---
# Genere un secreto JWT con:  openssl rand -base64 48
JWT_SECRET=cambie-este-valor-por-un-secreto-aleatorio-de-al-menos-32-bytes
SEED_ADMIN_PASSWORD=cambie-esta-clave-admin
SEED_USER_PASSWORD=cambie-esta-clave-user

# --- Base de datos PostgreSQL (la usa docker compose) ---
POSTGRES_DB=torneos
POSTGRES_USER=torneos
POSTGRES_PASSWORD=cambie-esta-clave-de-base-de-datos

# --- Puerto publicado en su computador ---
APP_PORT=8080

# --- Opcionales ---
# Asistente LLM (sin clave, el asistente indica que no está configurado)
OPENAI_API_KEY=
# Datasets de datos abiertos (Socrata). Reemplace por los IDs reales.
DATOS_GOV_CO_DATASET_ID=CAMBIAR_ID_DATASET
DANE_DATASET_ID=CAMBIAR_ID_DATASET
